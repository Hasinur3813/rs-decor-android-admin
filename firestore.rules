rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // The mobile app is a public catalog client; all writes go through the
    // authenticated admin server using the Firebase Admin SDK.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /designs/{designId} {
      allow read: if true;
      allow write: if false;
    }

    match /subcategories/{subcategoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /settings/app {
      allow read: if true;
      allow write: if false;
    }

    // All other settings docs (e.g. settings/integrations holding API
    // secrets) are Admin-SDK-only: no client access of any kind.
    match /settings/{settingId} {
      allow read, write: if false;
    }
  }
}