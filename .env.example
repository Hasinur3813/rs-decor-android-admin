# ---- Firebase Admin (server only, never expose to browser) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes as-is; the app converts them to real newlines
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional: non-default database id. Leave blank for (default)
FIREBASE_DATABASE_ID=

# ---- Cloudinary (server only) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder prefix for uploads, e.g. rs-decor
CLOUDINARY_FOLDER=rs-decor

# ---- Admin auth (NextAuth credentials + httpOnly session cookie) ----
# Pick a username, then run:  npm run gen-password -- "YourStrongPassword"
# and paste the printed salt:hash line below. Every API route verifies the
# server session — the browser key model is gone.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Random 32+ byte secret for session signing. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
# Public URL of the panel (needed in production for the auth cookie)
NEXTAUTH_URL=http://localhost:3000
# Public hint only
NEXT_PUBLIC_APP_NAME=RS Decor Admin
